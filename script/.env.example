# Example environment variables for Foundry deploy scripts
# Copy to script/.env and fill in your values. Do NOT commit script/.env.

# RPC URL of the target network
RPC_URL=

# Deployer's private key (0x-prefixed hex) — DO NOT COMMIT REAL KEYS
PRIVATE_KEY=

# Etherscan (or explorer) API key for verification
ETHERSCAN_API_KEY=

# Path to deployment config JSON
# e.g. script/config/governance.council.example.json (edit/copy for your network)
COUNCIL_CONFIG=

# Tip: To load vars into your current shell before running scripts:
#   set -a; source script/.env; set +a
